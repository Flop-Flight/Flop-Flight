rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'plan']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.plan in ['standard', 'pro'];
    }

    function isJoinAction() {
       return incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'upgradedAt']);
    }

    function isValidChatHistory(data) {
      return data.keys().hasAll(['userId', 'query', 'answer', 'subject', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.query is string && data.query.size() <= 5000 &&
             data.answer is string && data.answer.size() <= 10000 &&
             data.subject is string && data.subject.size() <= 50 &&
             data.timestamp == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.role in ['user', 'bot'] &&
             data.content is string && data.content.size() <= 10000 &&
             data.timestamp == request.time;
    }

    function isValidThread(data) {
      return data.keys().hasAll(['title', 'updatedAt', 'userId']) &&
             data.title is string && data.title.size() <= 100 &&
             data.userId == request.auth.uid &&
             data.updatedAt == request.time;
    }

    // Collection matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) ||
        isJoinAction()
      );

      match /history/{historyId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatHistory(incoming()) && isValidId(historyId);
        allow delete: if isOwner(userId);
      }

      match /threads/{threadId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidThread(incoming()) && isValidId(threadId);
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt'])
        );
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(incoming()) && isValidId(messageId);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
